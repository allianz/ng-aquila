<h4 id="{{interface.name}}" class="docs-header-link docs-api-h4 docs-api-interface-name">
    <span header-link="{{interface.name}}"></span>
    <code>{{interface.name}}</code>
</h4>

{{~#if interface.description~}}
<p class="docs-api-interface-description">{{marked interface.description}}</p>
{{~/if~}} {{~#if interface.isDeprecated~}}
<div class="docs-api-interface-deprecated-marker" {{> deprecationTitle doc=interface}}> Deprecated </div>
{{~/if~}} {{> propertyList propertyList=interface.properties}} {{> methodList methodList=interface.methods}}
