{{!-- The id lets the search link to a single property. It uses the alias when there is one, so that
it matches the name the search indexes and the name the property is used by. --}}
<tr class="docs-api-properties-row" id="{{property.containerDoc.name}}.{{or property.nameAlias property.name}}">
    <td class="docs-api-properties-name-cell">
        {{~#if property.isDirectiveInput~}}
            <div class="docs-api-input-marker">
                <span class="docs-api-input__badge">Input  
                    {{~#if property.nameAlias~}}
                       { alias:  <strong>{{property.nameAlias}}</strong> }
                    {{~/if~}}
                </span>
                {{~#if property.directiveInputAlias~}}
                    <span class="docs-api-input__keyword">
                        @Input
                        (<span class="docs-api-input-alias">{{property.directiveInputAlias}}</span>) 
                    </span>
                {{else if property.hasDecorator}}
                    <span class="docs-api-input__keyword">@Input</span>() 
                {{~/if~}}
            </div>
        {{~/if~}} 

        {{~#if property.isDirectiveOutput~}}
            <div class="docs-api-output-marker">
                <span class="docs-api-output__badge">Output
                    {{~#if property.nameAlias~}}
                       { alias:  <strong>{{property.nameAlias}}</strong> }
                    {{~/if~}}
                </span>
                {{~#if property.directiveOutputAlias~}}
                    <span class="docs-api-output__keyword">
                        @Output
                        (<span class="docs-api-output-alias">{{property.directiveOutputAlias}}</span>) 
                    </span>
                {{else if property.hasDecorator}}
                    <span class="docs-api-output__keyword">@Output</span>() 
                {{~/if~}}
            </div>
        {{~/if~}} 
        
        {{~#if property.isDeprecated~}}
            <div class="docs-api-deprecated-marker" {{> deprecationTitle doc=property}}> Deprecated </div>
        {{~/if~}}

        <p class="docs-api-property">
            <code>
                <span class="docs-api-property__name">
                {{property.name}}{{~#if property.isOptional~}}?{{~/if~}}: 
                </span>
                 
                <span class="docs-api-property__type">{{escape property.type}}</span>
            </code>
        </p>
    </td>
    <td class="docs-api-property-description">
        {{marked property.description}} {{~#if property.deletionTarget~}}
        <strong>Deletion target:</strong> {{property.deletionTarget}} {{~/if~}}
    </td>
</tr>
