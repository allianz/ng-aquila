<h4 id="{{class.name}}" class="docs-header-link docs-api-h4 docs-api-class-name">
    <span header-link="{{class.name}}"></span>
    <code>{{class.name}}</code>
    {{~#if class.extendedDoc~}}
    <span class="docs-api-class-extends-clauses">
        <span class="docs-api-class-extends-label">extends</span>
        <span class="docs-api-class-extends-type">{{escape class.extendedDoc.text}}</span>
    </span>
    {{~/if~}}
</h4>

{{~#if class.description~}}
<p class="docs-api-class-description">{{marked class.description}}</p>
{{~/if~}}

{{~#if class.directiveSelectors~}}
<p class="docs-api-directive-selectors">
    <span class="docs-api-class-selector-label ">Selector:</span>
    {{#each class.directiveSelectors as |selector|}}
        <code class="docs-api__selector-container nx-margin-left-2xs">
            <span class="docs-api-class-selector-name">{{selector}}</span>
        </code>
    {{/each}}
</p>
{{~/if~}}

{{~#if class.directiveExportAs~}}
<p class="docs-api-directive-selectors">
<span class="docs-api-class-export-label">Exported as:</span>
<span class="docs-api-class-export-name">{{class.directiveExportAs}}</span>
</p>
{{~/if~}}

{{~#if class.isDeprecated~}}
    <span class="docs-api-class-deprecated-marker" {{> deprecationTitle doc=class}}>
        Deprecated
    </span>
    {{~#if class.deprecated~}}
        {{marked class.deprecated}}
    {{~/if~}}
    {{~#if class.deletionTarget~}}
        <strong>Deletion target:</strong> {{class.deletionTarget}}
    {{~/if~}}
{{~/if~}}

{{> propertyList propertyList=class.properties}}

{{> methodList methodList=class.methods}}
