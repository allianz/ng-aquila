{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "strictMetadataEmit": true,
    "enableResourceInlining": true
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test-utils.ts",
    "documentation/**/*",
    "src/test-setup/**",
    "src/types/vitest.d.ts"
  ]
}
