{
  "name": "ng-aquila-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "ng-high-memory": "cross-env NODE_OPTIONS=--max-old-space-size=7680 ng",
    "start": "npm run build:package:themes && npm run library:generate:docs && ng serve opensource-documentation",
    "build": "npm run build:lib && npm run build:docs",
    "build:lib": "npm run ng-high-memory -- build ng-aquila && npm run build:package:full",
    "build:docs": "npm run generate:llms-txt && npm run library:generate:docs && npm run ng-high-memory -- build opensource-documentation",
    "start:ssr-playground": "npm run build:package:themes && ng serve ssr-playground",
    "build:ssr-playground": "npm run build:package:themes && npm run ng-high-memory -- build ssr-playground --configuration production",
    "test:ssr-playground": "npm run build:package:themes && ng e2e ssr-playground",
    "build:package:full": "node ./scripts/build-package.js",
    "build:package:themes": "node ./scripts/build-package-themes.js",
    "build:package:schematics": "node ./scripts/build-package-schematics.js",
    "sizes": "node ./scripts/entry-point-sizes.js report ./dist/ng-aquila",
    "sizes:diff": "node ./scripts/entry-point-sizes.js diff",
    "generate:llms-txt": "node scripts/generate-llms-txt.js",
    "figma:gen-config": "node scripts/figma-gen-config.js",
    "figma:check-config": "node -e \"require('fs').existsSync('figma.config.json') || (console.error('Missing figma.config.json, run npm run figma:gen-config, see the Figma Code Connect section in DEVELOPER.md'), process.exit(1))\"",
    "figma:preview": "npm run figma:check-config --silent && figma connect preview",
    "figma:publish": "npm run figma:check-config --silent && figma connect publish --exit-on-unreadable-files",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint projects/ng-aquila/src/schematics/**/*.ts --quiet && eslint projects/ngx-docs-cli/**/*.ts --quiet && ng lint --quiet",
    "lint:fix": "eslint --fix projects/ng-aquila/src/schematics/**/*.ts && eslint --fix projects/ngx-docs-cli/**/*.ts && ng lint --fix",
    "mcp:init": "npm run mcp:generate-resources && npm run mcp:build && npm run mcp:copy-resources",
    "mcp:generate-resources": "node scripts/mcp-generate-resources.js",
    "mcp:build": "rimraf dist/ng-aquila/mcp/src && tsc --project projects/ng-aquila/mcp/tsconfig.json --outDir dist/ng-aquila/mcp/src && node -e \"require('fs').chmodSync('dist/ng-aquila/mcp/src/index.js', 0o755)\"",
    "mcp:copy-resources": "node scripts/mcp-copy-resources.js",
    "mcp:test-search": "node scripts/mcp-test-search.mjs",
    "postinstall": "node projects/ng-aquila/src/phone-input/extract-calling-codes.js",
    "prepare": "husky",
    "release": "standard-version -n",
    "test": "npm run test:schematics && npm run test:docs-ui:coverage && npm run test:lib:coverage",
    "test:lib": "npm run build:package:themes && ng test ng-aquila",
    "test:lib:coverage": "npm run build:package:themes && ng test ng-aquila --watch=false --coverage --reporters=dot",
    "test:docs-ui": "ng test ngx-docs-ui",
    "test:docs-ui:coverage": "ng test ngx-docs-ui --watch=false --coverage --reporters=dot",
    "test:schematics": "npm run build:package:schematics && jasmine --config=projects/ng-aquila/src/schematics/test/jasmine.json",
    "browserslist": "browserslist --coverage && browserslist",
    "browserslist:update": "browserslist --update-db",
    "library:generate:docs": "npm run cli -- generate projects/ng-aquila",
    "cli": "ts-node --project projects/ngx-docs-cli/tsconfig.json ./projects/ngx-docs-cli/src/main"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://www.github.com/allianz/ng-aquila.git"
  },
  "sideEffects": false,
  "private": true,
  "dependencies": {
    "@angular-devkit/schematics": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@commander-js/extra-typings": "^11.1.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@stackblitz/sdk": "^1.11.1",
    "@standard-schema/spec": "^1.1.0",
    "@typescript-eslint/types": "^8.73.0",
    "@typescript-eslint/utils": "^8.73.0",
    "ag-grid-angular": "^33.3.2",
    "ag-grid-community": "^33.3.2",
    "chalk": "^5.6.2",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "i18n-iso-countries": "^7.14.0",
    "ibantools": "^4.5.4",
    "libphonenumber-js": "^1.13.17",
    "moment": "^2.31.0",
    "parse-color": "^1.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.3.0",
    "@angular-devkit/schematics-cli": "^22.3.0",
    "@angular-eslint/builder": "^22.8.0",
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/schematics": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-angular": "^18.6.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@figma/code-connect": "2.1.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^24.19.2",
    "@types/parse-color": "^1.0.3",
    "@types/shelljs": "^0.10.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "angular-eslint": "^22.8.0",
    "axe-core": "^4.14.1",
    "chokidar": "^6.0.0",
    "commander": "^11.1.0",
    "core-js": "^3.51.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^53.0.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.4.1",
    "glob": "^7.2.3",
    "handlebars": "^4.7.10",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine": "^5.13.0",
    "jasmine-core": "^5.13.0",
    "jasmine-spec-reporter": "^7.0.0",
    "lint-staged": "^16.4.0",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^9.2.1",
    "ng-packagr": "^22.3.0",
    "playwright": "^1.65.1",
    "playwright-ng-schematics": "^22.1.4",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "shelljs": "^0.10.0",
    "standard-version": "^9.5.0",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0"
  }
}
